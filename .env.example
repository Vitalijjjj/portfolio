# Supabase — публічні ключі проєкту
# Dashboard → Settings → API
#
# У проєкті немає збірки, тому ці значення вписуються вручну
# у файл site/js/supabase-config.js (url та anonKey).
# anon key — публічний за дизайном: доступ обмежують RLS-політики.
# service_role ключ НІКОЛИ не додавайте у фронтенд.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key...
